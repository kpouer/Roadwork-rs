{
  "name": "France",
  "isoCode": "FR",
  "sourceUrl": "https://geo.api.gouv.fr/",
  "producer": "Direction interministérielle du numérique (DINUM)",
  "addresses": {
    "url": "https://data.geopf.fr/geocodage/reverse",
    "latParam": "lat",
    "lonParam": "lon",
    "limitParam": "limit",
    "limit": 20,
    "dataArray": "$.features[*]",
    "labelPath": "$.properties.label",
    "numberPath": "$.properties.housenumber",
    "streetPath": "$.properties.street",
    "cityPath": "$.properties.city",
    "postcodePath": "$.properties.postcode",
    "geometryPath": "$.geometry"
  },
  "levels": [
    {
      "name": "région",
      "url": "https://geo.api.gouv.fr/regions?fields=nom,code&geometry=geojson",
      "codeParam": "code",
      "dataArray": "$[*]",
      "namePath": "$.nom",
      "codePath": "$.code",
      "polygonPath": "$.geometry",
      "centerPath": "$.geometry.coordinates"
    },
    {
      "name": "département",
      "url": "https://geo.api.gouv.fr/departements?fields=nom,code,codeRegion&geometry=geojson",
      "codeParam": "code",
      "parentParams": { "région": "codeRegion" },
      "parentCodes": { "région": "$.codeRegion" },
      "dataArray": "$[*]",
      "namePath": "$.nom",
      "codePath": "$.code",
      "polygonPath": "$.geometry",
      "centerPath": "$.geometry.coordinates"
    },
    {
      "name": "commune",
      "url": "https://geo.api.gouv.fr/communes?fields=nom,code,codeDepartement,codeRegion&format=geojson&geometry=contour",
      "latParam": "lat",
      "lonParam": "lon",
      "parentParams": { "département": "codeDepartement" },
      "parentCodes": {
        "département": "$.properties.codeDepartement",
        "région": "$.properties.codeRegion"
      },
      "dataArray": "$.features[*]",
      "namePath": "$.properties.nom",
      "codePath": "$.properties.code",
      "polygonPath": "$.geometry"
    }
  ]
}