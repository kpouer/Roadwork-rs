{
  "metadata": {
    "country": "Belgium",
    "id": "Belgium/Belgium-Liege",
    "name": "Liège",
    "producer": "Direction de la Voirie et des Déplacements - Ville de Paris",
    "licence_name": "Open Database License (ODbL)",
    "licence_url": "https://opendatacommons.org/licenses/odbl/",
    "source_url": "https://opendata.liege.be/explore/dataset/infos-travaux/information/?disjunctive.categories",
    "url": "https://opendata.liege.be/api/records/1.0/search/?dataset=infos-travaux&q=&rows=1000&facet=categories&facet=start_date&facet=tentative_end_date",
    "center": {
      "lat": 50.6246894,
      "lon": 5.5292386
    },
    "locale": "fr_BE"
  },
  "data_array": "$.records[*]",
  "id": "$.recordid",
  "latitude": "$.geometry.coordinates[1]",
  "longitude": "$.geometry.coordinates[0]",
  "road": "$.fields.voie",
  "location_details": "$.fields.precision_localisation",
  "impact_circulation_detail": "$.fields.impact_circulation_detail",
  "description": "$.fields.description",
  "from": {
    "path": "$.fields.start_date",
    "parsers": [
      {
        "matcher": ".*",
        "format": "%Y-%m-%d"
      }
    ]
  },
  "to": {
    "path": "$.fields.tentative_end_date",
    "parsers": [
      {
        "matcher": ".*",
        "format": "dd/MM/yyyy"
      }
    ]
  }
}