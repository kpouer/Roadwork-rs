{
  "metadata": {
    "country": "France",
    "name": "Toulouse",
    "producer": "Toulouse Métropole",
    "licence_name": "Licence Ouverte v2.0 (Etalab)",
    "licence_url": "https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf",
    "source_url": "https://data.toulouse-metropole.fr/explore/dataset/chantiers-en-cours/information/",
    "url": "https://data.toulouse-metropole.fr/api/records/1.0/search/?dataset=chantiers-en-cours&q=&rows=1000&facet=voie&facet=commune&facet=pole&facet=declarant&facet=entreprise&facet=datedebut&facet=datefin",
    "center": {
      "lat":43.60072,
      "lon":1.44118
    },
    "locale": "fr_FR"
  },
  "data_array": "$.records[*]",
  "id": "$.recordid",
  "latitude": "$.geometry.coordinates[1]",
  "longitude": "$.geometry.coordinates[0]",
  "polygon": "$.fields.geo_shape.coordinates",
  "road": "$.fields.voie",
  "location_details": "$.fields.libelle",
  "impact_circulation_detail": "$.fields.circulation",
  "from": {
    "path": "$.fields.datedebut",
    "parsers": [
      {
        "matcher": "(.*)T.*",
        "format": "%Y-%m-%d"
      }
    ]
  },
  "to": {
    "path": "$.fields.datefin",
    "parsers": [
      {
        "matcher": "(.*)T.*",
        "format": "%Y-%m-%d"
      }
    ]
  }
}