{
  "metadata": {
    "country": "France",
    "id": "France-Rennes",
    "name": "Rennes",
    "producer": "Rennes Métropole",
    "source_url": "http://travaux.data.rennesmetropole.fr/#roadwork-info",
    "url": "http://travaux.data.rennesmetropole.fr/api/roadworks?epsg=4326",
    "center": {
     "lat":48.10881,
     "lon":-1.67018
    },
    "locale": "fr_FR"
  },
  "data_array": "$.features[*]",
  "id": "$.properties.id",
  "latitude": "$.geometry.coordinates[0][1]",
  "longitude": "$.geometry.coordinates[0][0]",
  "road": "$.properties.localisation",
  "description": "$.properties.libelle",
  "impact_circulation_detail": "$.properties.type",
  "from": {
    "path": "$.properties.date_deb",
    "parsers": [
      {
        "matcher": ".*",
        "format": "%Y-%m-%d 00:00:00"
      }
    ]
  },
  "to": {
    "path": "$.properties.date_fin",
    "parsers": [
      {
        "matcher": ".*",
        "format": "%Y-%m-%d 00:00:00"
      }
    ]
  }
}